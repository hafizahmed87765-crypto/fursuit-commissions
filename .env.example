# ── Site ─────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://fursuitcommissions.com

# ── WooCommerce (shop + checkout stay in WordPress) ──────────────────
# Origin of the WordPress/WooCommerce install that handles cart, checkout,
# PayPal and My Account. When this Next.js site takes over the main domain,
# move WordPress to a subdomain (e.g. https://shop.fursuitcommissions.com)
# and set it here. Leave EMPTY to hide buy buttons (products then show
# "Ask about this item" instead) — never point it at this Next.js site.
NEXT_PUBLIC_WOO_ORIGIN=

# ── Quote / repair / contact form email (SMTP) ───────────────────────
# Forms send an email to OWNER_EMAIL. Without SMTP settings the API returns
# 503 and the form shows a clear "could not send" fallback — never a fake
# success.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FursuitCommissions.com <no-reply@fursuitcommissions.com>"
OWNER_EMAIL=

# ── Analytics (optional, loads only after cookie consent) ────────────
# Existing Google Tag Manager container found on the live site.
NEXT_PUBLIC_GTM_ID=GTM-57MGG25L
